---
interface Props {
  event?: {
    title: string;
    image?: string;
    startsAt: string;
    schedule: string;
    venue: string;
    summary: string;
    participationUrl: string;
    demo?: boolean;
  };
}

const { event } = Astro.props;
---

<section class:list={["upcoming", { "upcoming-featured": event }]} id="prochain-evenement" aria-labelledby="upcoming-title">
  <div class="in">
    <div class:list={["feature", { "with-photo": event?.image }]}>
      {event?.image && (
        <div class="event-visual">
          <img src={event.image} alt="" />
        </div>
      )}
      <div class="event-information">
        <h2 class="label" id="upcoming-title">Prochain événement</h2>
        {event ? (
          <>
            <h3>{event.title}</h3>
            <div class="event-schedule">
              <time datetime={event.startsAt}>{event.schedule}</time>
              <p>{event.venue}</p>
            </div>
            <p class="event-summary">{event.summary}</p>
            <div class="action">
              <a class="btn btn-beige" href={event.participationUrl}>Participer</a>
              {event.demo && <p class="demo" id="participation-demo" tabindex="-1">Événement fictif. Les inscriptions sont fermées.</p>}
            </div>
          </>
        ) : (
          <>
            <p>Aucune nouvelle date n’est annoncée pour le moment.</p>
            <div class="action">
              <a class="btn btn-beige" href="https://www.instagram.com/moana_uga/">Voir les annonces</a>
            </div>
          </>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .upcoming {
    background: var(--surface);
  }

  .upcoming .in {
    padding-block: 2rem;
  }

  .upcoming-featured .in {
    padding: 0;
  }

  .upcoming-featured .feature {
    min-block-size: calc(100svh / var(--site-scale, 1));
  }

  .feature {
    display: grid;
    overflow-wrap: anywhere;
  }

  .feature.with-photo {
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
  }

  .event-visual {
    position: relative;
    min-height: 22rem;
    background: var(--beige);
  }

  .event-visual img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .event-information {
    --event-panel-inset: clamp(1.75rem, 5vw, 5rem);
    --event-panel-muted: color-mix(in srgb, var(--on-green) 78%, var(--green));
    display: grid;
    background: var(--green);
    color: var(--on-green);
    align-content: center;
    gap: clamp(.85rem, 1.6vw, 1.35rem);
    padding: clamp(2rem, 5vw, 4rem) var(--event-panel-inset);
  }

  .event-information .label {
    font-family: var(--f-body);
    color: color-mix(in srgb, var(--on-green) 75%, var(--olive));
    font-weight: 600;
  }

  h3 {
    font-size: clamp(2rem, 4.2vw, 4.2rem);
    max-inline-size: 18ch;
  }

  .event-schedule {
    display: grid;
    gap: .25rem;
    margin-block-start: .25rem;
    padding-block-start: .9rem;
    max-inline-size: 38ch;
    border-block-start: 1px solid color-mix(in srgb, var(--on-green) 32%, transparent);
  }

  .event-schedule p, .demo {
    color: var(--event-panel-muted);
  }

  .event-summary {
    max-inline-size: 40ch;
    font-size: 1.12rem;
    line-height: 1.6;
  }

  .event-schedule time {
    font-weight: 600;
    text-transform: capitalize;
  }

  .demo {
    font-size: .9rem;
  }

  .action {
    display: grid;
    gap: .75rem;
    margin-block-start: .35rem;
    justify-items: start;
  }

  .action .btn {
    justify-content: center;
    text-align: center;
  }

  .action .btn:active {
    background: color-mix(in srgb, var(--beige) 82%, var(--olive));
  }

  @media (width > 760px) {
    .feature.with-photo {
      --feature-slant: clamp(1.5rem, 4vw, 4rem);
    }

    .with-photo .event-visual {
      margin-inline-end: calc(-1 * var(--feature-slant));
    }

    .with-photo .event-information {
      clip-path: polygon(var(--feature-slant) 0, 100% 0, 100% 100%, 0 100%);
      padding-inline-start: calc(var(--event-panel-inset) + var(--feature-slant));
    }
  }

  @media (width <= 760px) {
    .feature.with-photo {
      grid-template-columns: minmax(0, 1fr);
    }

    .event-visual {
      min-height: max(16rem, calc(45svh / var(--site-scale, 1)));
    }

    .action .btn {
      box-sizing: border-box;
      width: 100%;
    }
  }
</style>
