<section class="name" id="nom">
  <div class="in name-grid">
    <div class="word">
      <span class="ar" lang="ar" dir="rtl" translate="no">مُعاوَنة</span>
      <span class="translit">mu‘āwana</span>
      <span class="meaning">l'entraide</span>
